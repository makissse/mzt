modules = ["nodejs-20", "web", "bash", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/mzt: web"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 BASE_PATH=/api pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[[workflows.workflow]]
name = "artifacts/mzt: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=19721 BASE_PATH=/ pnpm --filter @workspace/mzt run dev"
waitForPort = 19721

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-36d7a2c6-e1d3-4fc4-b1da-0305e4414166"

[userenv]

[userenv.shared]
VAPID_PUBLIC_KEY = "BBdydYVua5wEHid0e7LS6uYPNZHtRaMNqlzV3IMYEISFjx3cz6yHEfq0R7I7OQZw9WSKnyopxmRoNiPXVoCCE1U"
